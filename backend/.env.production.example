# ─────────────────────────────────────────────────────────
# Eggova Production Environment
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to git!
# ─────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL — Docker Compose auto-injects DATABASE_URL
# (set DB_USER, DB_PASSWORD, DB_NAME in .env at project root)
DB_USER=eggova
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=eggova_db

# JWT
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# Razorpay (switch to live keys in production)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Firebase service account path (mounted as volume in Docker)
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
